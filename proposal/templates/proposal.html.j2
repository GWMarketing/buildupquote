<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Proposal{% if data.proposal_number %} {{ data.proposal_number }}{% endif %}</title>
<style>
  /* ============================================================
     Buildup Quote - branded proposal PDF stylesheet.
     Print-first CSS rendered by WeasyPrint (proposal/render.py).
     Palette mirrors the app (ui.py): ink #1F2A37, brand blue
     #0F6CBD, deep navy #0F2A43, cool neutrals.
     ============================================================ */
  body {
    font-family: "Helvetica Neue", Helvetica, Arial, "DejaVu Sans", sans-serif;
    font-size: 10.5pt; line-height: 1.5; color: #1F2A37; margin: 0;
  }
  p { orphans: 3; widows: 3; }
  h1, h2, h3 { page-break-after: avoid; }

  /* ---- letterhead: contractor info left, claim info right ---- */
  .header-table { width: 100%; margin-bottom: 16px; }
  .header-table td { vertical-align: top; padding: 0; }
  .logo { max-height: 60px; max-width: 220px; margin-bottom: 8px; display: block; }
  .contractor-name { font-size: 20pt; font-weight: 700; color: #0F2A43; margin-bottom: 3px; }
  .contractor-line { font-size: 10pt; color: #5B6B7C; margin-bottom: 1px; }

  .claim-box {
    background: #F4F7FA; border: 1px solid #D9E0E8; border-radius: 6px;
    padding: 10px 12px; font-size: 9.5pt; page-break-inside: avoid;
  }
  .claim-box h3 {
    margin: 0 0 7px 0; font-size: 9pt; text-transform: uppercase; letter-spacing: .7px;
    color: #0F2A43; border-bottom: 1.5px solid #C9D6E3; padding-bottom: 4px;
  }
  .claim-box table { width: 100%; }
  .claim-box td { padding: 1.5px 0; vertical-align: top; }
  .claim-box td.label {
    width: 40%; font-size: 8.5pt; color: #7A8896;
    text-transform: uppercase; letter-spacing: .3px;
  }

  /* ---- document title ---- */
  h1.title {
    text-align: center; font-size: 13.5pt; text-transform: uppercase; letter-spacing: 2px;
    color: #0F2A43; border-top: 2.5px solid #0F2A43; border-bottom: 2.5px solid #0F2A43;
    padding: 8px 0; margin: 4px 0 10px 0;
  }
  .proposal-meta { text-align: right; font-size: 9.5pt; color: #5B6B7C; margin-bottom: 14px; }

  /* ---- itemized scope of work ---- */
  table.items { width: 100%; table-layout: fixed; margin-bottom: 8px; }
  table.items thead { display: table-header-group; }
  table.items th {
    text-align: left; background: #0F2A43; color: #fff; padding: 6px 8px;
    font-size: 9pt; text-transform: uppercase; letter-spacing: .5px; font-weight: 700;
  }
  table.items th.num { text-align: right; }
  table.items td {
    padding: 5px 8px; border-bottom: 1px solid #E2E7ED;
    font-size: 10pt; vertical-align: top; overflow-wrap: break-word;
  }
  table.items tr { page-break-inside: avoid; }
  table.items tr.trade-header td {
    background: #F4F7FA; color: #0F6CBD; font-weight: 700;
    border-top: 1.5px solid #C9D6E3; border-bottom: 1px solid #D9E0E8;
  }
  table.items tr.trade-header { page-break-after: avoid; }
  table.items tr.subtotal td { font-weight: 700; border-top: 1px solid #AEBBC9; border-bottom: none; }
  /* The code/law justification printed under a code-required line item --
     its own little row, so an adjuster can read why the item is there. */
  table.items tr.item-note td {
    padding: 3px 8px 7px 16px; font-size: 8.5pt; color: #5B6B7C;
    line-height: 1.4; border-bottom: 1px solid #E2E7ED;
    border-left: 2px solid #0F6CBD; background: #F7FAFD;
  }
  table.items tr.item-note { page-break-before: avoid; }
  table.items tr.item-note .note-kicker {
    font-weight: 700; color: #0F6CBD; text-transform: uppercase;
    font-size: 7.5pt; letter-spacing: .4px; margin-right: 4px;
  }
  .num { text-align: right; white-space: nowrap; }

  /* ---- summary by trade ---- */
  .trade-summary { margin: 4px 0 14px 0; page-break-inside: avoid; }
  .trade-summary h3 {
    margin: 0 0 6px 0; font-size: 9.5pt; text-transform: uppercase; letter-spacing: .6px;
    color: #0F2A43; border-bottom: 1.5px solid #C9D6E3; padding-bottom: 4px;
  }
  table.trade-summary-table { width: 100%; }
  table.trade-summary-table td { padding: 3px 8px 3px 0; font-size: 10pt; border-bottom: 1px solid #EDF1F5; }
  table.trade-summary-table td.num { text-align: right; white-space: nowrap; }

  /* ---- totals ---- */
  .grand-total {
    text-align: right; font-size: 14pt; font-weight: 700; color: #0F2A43;
    margin: 10px 0 20px 0; padding-top: 8px; border-top: 3px double #0F2A43;
  }

  .totals-block { margin: 10px 0 20px 0; page-break-inside: avoid; }
  table.totals-table { width: 100%; }
  table.totals-table td { padding: 3px 0; font-size: 10.5pt; }
  table.totals-table td.num { text-align: right; white-space: nowrap; }
  table.totals-table tr.grand td {
    font-size: 14pt; font-weight: 700; color: #0F2A43;
    padding-top: 8px; border-top: 3px double #0F2A43;
  }

  /* ---- payment schedule ---- */
  .payment-schedule { margin: 14px 0; page-break-inside: avoid; }
  .payment-schedule h3 {
    margin: 0 0 4px 0; font-size: 9.5pt; text-transform: uppercase; letter-spacing: .6px;
    color: #0F2A43; border-bottom: 1.5px solid #C9D6E3; padding-bottom: 4px;
  }
  .payment-schedule-intro { font-size: 9pt; color: #5B6B7C; margin: 4px 0 8px 0; }
  table.payment-schedule-table { width: 100%; }
  table.payment-schedule-table tr { page-break-inside: avoid; }
  table.payment-schedule-table td {
    padding: 5px 8px 5px 0; font-size: 9.5pt; vertical-align: top; border-bottom: 1px solid #EDF1F5;
  }
  table.payment-schedule-table td.step { width: 22px; padding-right: 7px; }
  table.payment-schedule-table td.step .badge {
    display: inline-block; width: 15px; height: 15px; line-height: 15px;
    border-radius: 50%; background: #0F6CBD; color: #fff;
    font-size: 8.5pt; font-weight: 700; text-align: center;
  }
  table.payment-schedule-table td.num {
    text-align: right; white-space: nowrap; font-weight: 700; width: 16%;
  }

  /* Texas Business and Commerce Code Sec. 27.02 requires this exact
     notice, on any contract of $1,000+, in at least 12-point boldfaced
     type -- a formatting requirement of the statute itself, not a style
     choice, so this box's font-size/weight must not be reduced below
     12pt/bold even if the rest of the document's type scale changes. */
  .tx-deductible-notice {
    font-size: 12pt; font-weight: bold; line-height: 1.45; color: #1F2A37;
    border: 1.5px solid #1F2A37; background: #FFF8EC; padding: 9px 11px;
    margin: 14px 0; page-break-inside: avoid;
  }

  /* ---- adjuster remarks (export toggle) ---- */
  .remarks { margin: 16px 0 20px 0; page-break-inside: avoid; }
  .remarks h3 {
    margin: 0 0 6px 0; font-size: 9.5pt; text-transform: uppercase; letter-spacing: .6px;
    color: #0F2A43; border-bottom: 1.5px solid #C9D6E3; padding-bottom: 4px;
  }
  .remarks-text {
    margin: 8px 0 0 0; font-size: 9pt; color: #5B6B7C; line-height: 1.5;
    white-space: pre-wrap; background: #F4F7FA; border-left: 3px solid #0F6CBD;
    padding: 8px 10px; border-radius: 0 4px 4px 0;
  }

  /* ---- terms ---- */
  .terms {
    font-size: 9.5pt; color: #43505C; line-height: 1.5;
    margin-top: 8px; page-break-inside: avoid;
  }
  .terms h3 {
    font-size: 9.5pt; text-transform: uppercase; letter-spacing: .6px; color: #0F2A43;
    margin: 0 0 6px 0; border-bottom: 1.5px solid #C9D6E3; padding-bottom: 4px;
  }

  /* ---- signatures ---- */
  table.signatures { width: 100%; margin-top: 42px; page-break-inside: avoid; }
  table.signatures td { width: 50%; padding-right: 24px; font-size: 10pt; }
  .sig-line { border-top: 1px solid #AEBBC9; margin-top: 32px; margin-bottom: 4px; }
</style>
</head>
<body>

  <table class="header-table"><tr>
    <td style="width:56%;">
      {% if logo_uri %}<img class="logo" src="{{ logo_uri }}">{% endif %}
      <div class="contractor-name">{{ data.contractor.name }}</div>
      {% if data.contractor.address %}<div class="contractor-line">{{ data.contractor.address }}</div>{% endif %}
      <div class="contractor-line">
        {%- if data.contractor.phone %}{{ data.contractor.phone }}{% endif -%}
        {%- if data.contractor.phone and data.contractor.email %} &nbsp;|&nbsp; {% endif -%}
        {%- if data.contractor.email %}{{ data.contractor.email }}{% endif -%}
      </div>
      {% if data.contractor.license_number %}<div class="contractor-line">License #{{ data.contractor.license_number }}</div>{% endif %}
    </td>
    <td style="width:44%;">
      <div class="claim-box">
        <h3>Insurance Claim Information</h3>
        <table>
          <tr><td class="label">Insured</td><td>{{ data.claim.insured_name }}</td></tr>
          <tr><td class="label">Property</td><td>{{ data.claim.property_address }}</td></tr>
          <tr><td class="label">Insurance Co.</td><td>{{ data.claim.insurance_company }}</td></tr>
          <tr><td class="label">Claim #</td><td>{{ data.claim.claim_number }}</td></tr>
          <tr><td class="label">Policy #</td><td>{{ data.claim.policy_number }}</td></tr>
          <tr><td class="label">Type of Loss</td><td>{{ data.claim.type_of_loss }}</td></tr>
          <tr><td class="label">Date of Loss</td><td>{{ data.claim.date_of_loss }}</td></tr>
        </table>
      </div>
    </td>
  </tr></table>

  <h1 class="title">Scope of Work &amp; Proposal</h1>
  <div class="proposal-meta">
    {% if data.proposal_number %}Proposal #{{ data.proposal_number }} &nbsp;|&nbsp; {% endif %}Date: {{ data.proposal_date }}
  </div>

  <table class="items">
    <thead>
      <tr>
        <th style="width:46%;">Description</th>
        <th class="num" style="width:10%;">Qty</th>
        <th style="width:10%;">Unit</th>
        <th class="num" style="width:16%;">Unit Price</th>
        <th class="num" style="width:18%;">Total</th>
      </tr>
    </thead>
    <tbody>
    {% for group in data.grouped_items %}
    <tr class="trade-header"><td colspan="5">{{ group.trade }}</td></tr>
    {% for item in group.items %}
    <tr>
      <td>{{ item.description }}</td>
      <td class="num">{{ "%.2f"|format(item.quantity) }}</td>
      <td>{{ item.unit }}</td>
      <td class="num">${{ "%.2f"|format(item.unit_price) }}</td>
      <td class="num">${{ "{:,.2f}".format(item.line_total) }}</td>
    </tr>
    {% if item.note %}
    <tr class="item-note">
      <td colspan="5"><span class="note-kicker">Why this line is here:</span> {{ item.note }}</td>
    </tr>
    {% endif %}
    {% endfor %}
    {% endfor %}
    </tbody>
  </table>

  {% if data.grouped_items|length > 1 %}
  <div class="trade-summary">
    <h3>Summary by Trade</h3>
    <table class="trade-summary-table">
      {% for group in data.grouped_items %}
      <tr><td>{{ group.trade }}</td><td class="num">${{ "{:,.2f}".format(group.subtotal) }}</td></tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  {% if data.tax_label %}
  <div class="totals-block">
    <table class="totals-table">
      <tr><td>Subtotal</td><td class="num">${{ "{:,.2f}".format(data.subtotal) }}</td></tr>
      <tr><td>Sales Tax &mdash; {{ data.tax_label }}</td><td class="num">${{ "{:,.2f}".format(data.tax_amount) }}</td></tr>
      <tr class="grand"><td>Total Contract Price</td><td class="num">${{ "{:,.2f}".format(data.total_price) }}</td></tr>
    </table>
  </div>
  {% else %}
  <div class="grand-total">Total Contract Price: ${{ "{:,.2f}".format(data.total_price) }}</div>
  {% endif %}

  <div class="payment-schedule">
    <h3>Payment Schedule</h3>
    <p class="payment-schedule-intro">
      The total above is not due all at once -- here is when each part of it is actually paid.
    </p>
    <table class="payment-schedule-table">
      <tr>
        <td class="step"><span class="badge">1</span></td>
        <td>Deductible &mdash; paid directly to {{ data.contractor.name }} by the homeowner, in
          full. Required by Texas law ({{ deductible_law_citation }}); never paid by insurance
          and never absorbed into this price.</td>
        <td class="num">${{ "{:,.2f}".format(data.deductible_amount) }}</td>
      </tr>
      <tr>
        <td class="step"><span class="badge">2</span></td>
        <td>Due upon the insurance company's first (initial) payment.</td>
        <td class="num">${{ "{:,.2f}".format(data.first_check_amount) }}</td>
      </tr>
      {% if data.recoverable_depreciation_amount %}
      <tr>
        <td class="step"><span class="badge">3</span></td>
        <td>Recoverable depreciation &mdash; released by the insurance company once repairs
          are complete and proof is submitted.</td>
        <td class="num">${{ "{:,.2f}".format(data.recoverable_depreciation_amount) }}</td>
      </tr>
      {% endif %}
      {% if data.supplements_amount %}
      <tr>
        <td class="step"><span class="badge">4</span></td>
        <td>Supplements &mdash; scope added beyond the insurance company's original estimate,
          due upon completion.</td>
        <td class="num">${{ "{:,.2f}".format(data.supplements_amount) }}</td>
      </tr>
      {% endif %}
    </table>
  </div>

  {% if data.remarks %}
  <div class="remarks">
    <h3>Adjuster Notes &amp; Remarks</h3>
    <p class="remarks-text">{{ data.remarks }}</p>
  </div>
  {% endif %}

  {% if data.total_price >= 1000 %}
  <div class="tx-deductible-notice">{{ data.deductible_notice }}</div>
  {% endif %}

  <div class="terms">
    <h3>Terms &amp; Acceptance</h3>
    <p>{{ data.terms }}</p>
  </div>

  <table class="signatures"><tr>
    <td>
      <div class="sig-line">&nbsp;</div>
      Homeowner Signature &nbsp;&nbsp;&nbsp;&nbsp; Date: ______________
    </td>
    <td>
      <div class="sig-line">&nbsp;</div>
      Contractor Signature &nbsp;&nbsp;&nbsp;&nbsp; Date: ______________
    </td>
  </tr></table>

</body>
</html>
